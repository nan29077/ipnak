# 로컬 개발 환경 설정 가이드
# 1. docker-compose up -d 실행 (MariaDB 시작)
# 2. DATABASE_URL을 아래와 같이 설정
# 3. npx prisma db push 실행
# 4. npx tsx prisma/seed.ts 실행

DATABASE_URL="mysql://ipnak:ipnak_local@localhost:3306/ipnak"

# 세션/자격증명 암호화 시크릿 — 운영에서는 필수(미설정 시 AI 자격증명 사용 시점에 에러)
# 생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ipnak-dev-secret-change-me"

# 배포 기준 주소 (소셜 로그인 콜백 등)
NEXTAUTH_URL=

# 소셜 로그인 (선택)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# ===== AI 포인트 추천 (관리자 사이트 관리 > AI API 연결에서도 등록 가능) =====
# 배포 환경에서는 아래 환경 변수를 우선 사용합니다.
OPENAI_API_KEY=""
OPENAI_RECOMMEND_MODEL="gpt-4.1-mini"

# 네이버 검색 API
NAVER_SEARCH_CLIENT_ID=""
NAVER_SEARCH_CLIENT_SECRET=""

# 지도 API (선택)
NEXT_PUBLIC_KAKAO_MAP_KEY=""
NEXT_PUBLIC_NAVER_MAP_KEY=""

# 카카오톡 공유 (선택) — 카카오 개발자센터의 "JavaScript 키"
# 스마트피싱 기록 상세의 카카오톡 공유 버튼에 사용한다. 비워두면 버튼이 표시되지 않는다.
# (미설정 시 위의 NEXT_PUBLIC_KAKAO_MAP_KEY 를 그대로 재사용한다 — 같은 JavaScript 키)
# 카카오 개발자센터 > 내 애플리케이션 > 플랫폼 > Web 에 서비스 도메인 등록이 필요하다.
NEXT_PUBLIC_KAKAO_APP_KEY=""

# 결제/커머스 (mock)
PAYMENT_API_KEY=""
COMMERCE_AFFILIATE_KEY=""
# PG(결제대행) 연동 키
PG_API_KEY=""
PG_SECRET_KEY=""

# ===== AI 카메라 측정 모듈 (/measure, /diary) =====
# 측정 서버 API (미설정 시 로컬 저장만 사용, 동기화 대기)
NEXT_PUBLIC_API_BASE_URL=""
# "false" 로 바꾸면 실제 서버 API 호출 (기본: 목 모드)
NEXT_PUBLIC_USE_MOCK_API="true"
# AI 측정/추천 목 모드 — 운영 배포 시 false
NEXT_PUBLIC_USE_MOCK_AI=false
# 기상청 단기예보(초단기실황) API 키 — 날씨 자동 태그 (없어도 측정 동작)
NEXT_PUBLIC_WEATHER_API_KEY=""
# 바다누리(국립해양조사원) API 키 — 물때 자동 태그 (없어도 측정 동작)
NEXT_PUBLIC_TIDE_API_KEY=""
# 위치명 역지오코딩은 위의 NEXT_PUBLIC_KAKAO_MAP_KEY 를 재사용
# 외부 공유(Open Graph) 기준 주소. 운영 환경에서는 실제 HTTPS 도메인으로 설정하세요.
# 비워두면 Cloudflare 미리보기 등 현재 요청 도메인을 자동 사용합니다.
NEXT_PUBLIC_SITE_URL=

# ===== 입낚볼 / 입낚키링 NFC 태그 =====
# NFC 칩에 기록하는 URL 의 기준 도메인.
#   볼   : {NEXT_PUBLIC_TAG_BASE_URL}/ball?id=BALL-000001
#   키링 : {NEXT_PUBLIC_TAG_BASE_URL}/keyring?id=KRING-000001
# 관리자 화면의 "태그 URL 복사"와 안내 문구가 이 값을 사용합니다. (기본: https://ipnak.kr)
NEXT_PUBLIC_TAG_BASE_URL="https://ipnak.kr"
